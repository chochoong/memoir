            }
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "center_scene": {
            "type": "string"
          },
          "emotion": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "fiction_notes": {
            "type": "string"
          },
          "avoid_overlap": {
            "type": "string"
          }
        }
      }
    }
