                        "삶의 변화형",
                        "장면 중심형",
                        "감정·갈등형",
                        "문학적 절제형",
                        "대중적 자연형"
                      ]
                    },
                    "basis": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "stories": {
            "type": "array",
