                "kind": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "intensity": {
                  "type": "string"
                },
                "when": {
                  "type": "string"
                },
                "explicit": {
                  "type": "boolean"
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          },
          "facts": {
            "type": "array",
