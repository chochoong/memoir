              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text",
                "source",
                "certainty"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "source": {
                  "type": "string",
