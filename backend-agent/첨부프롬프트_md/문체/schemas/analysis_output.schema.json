          },
          "title_hint": {
            "type": "string"
          },
          "people": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "time": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "places": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "emotions_then": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reflections_now": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quotes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "heard": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "must_keep": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "emotion_notes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "who",
                "kind",
                "target",
                "intensity",
                "when",
                "explicit",
                "evidence"
              ],
              "properties": {
                "who": {
                  "type": "string"
