                    "self",
                    "heard",
                    "view"
                  ]
                },
                "certainty": {
                  "type": "string",
                  "enum": [
                    "stated",
                    "approx",
                    "uncertain"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "chapters": {
      "type": "array",
