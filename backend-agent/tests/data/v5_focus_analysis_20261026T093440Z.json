      "source": "self",
      "certainty": "stated",
      "keep": false
    },
    {
      "id": "f9",
      "turns": [
        6
      ],
      "text": "김 사장 덕분에 처음 몇 년을 버팀",
      "time": "",
      "source": "self",
      "certainty": "stated",
      "keep": false
    },
    {
      "id": "f10",
      "turns": [
        7
      ],
      "text": "아들, 딸 운동회를 거의 못 감",
