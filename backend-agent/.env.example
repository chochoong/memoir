# cp .env.example .env

# ── 배포 (docs/배포.md) ─────────────────────────────────────────────
# 공개 주소. **적는 순간 「배포 중」이 된다** — 주소를 담는 칸이 아니라 스위치다.
#   · 개발용 CORS 허용(localhost:5173)을 목록에서 뺀다
#   · /docs 와 /openapi.json 을 닫는다 (DOCS=1 로 되살린다)
#   · 신원 쿠키에 Secure 를 붙인다
# 끄는 것을 잊지 않도록 스위치를 따로 두지 않았다. 개발 중에는 비워 둔다.
PUBLIC_ORIGIN=

# 생성 상한이 어느 주소를 셀지. off(기본) / cf / xff
#   cf    Cloudflare Tunnel 뒤 — CF-Connecting-IP (엣지가 덮어쓰므로 위조 불가)
#   xff   일반 역프록시 뒤 — X-Forwarded-For 의 **맨 뒤** 값
# **터널 뒤에서 off 로 두면 전 세계가 127.0.0.1 한 칸을 나눠 쓴다** — 10분에 10회.
# 반대로 프록시가 없는데 켜면 헤더 한 줄로 상한을 피할 수 있다. 앞에 프록시가
# 있고 그 프록시만 이 서버에 닿을 수 있을 때만 켠다.
TRUST_PROXY=off

# 다른 출처에서 붙일 주소를 쉼표로. 끝 슬래시 없이.
# 화면을 이 서버가 web/ 에서 직접 내면 **같은 출처라 비워 두는 것이 정상이다.**
ALLOWED_ORIGINS=

# 배포 중에도 /docs 를 열어 둘지. 기본은 닫힘.
DOCS=

# ── PostgreSQL ──────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=memoir
PG_PASSWORD=change-me
PG_DB=memoir

# ── Gemini ──────────────────────────────────────────────────────────
# 비워 두면 고정 질문(fixed_questions)으로 돈다. 흐름은 그대로 돌아간다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# T2 최솟값 3초 안에 질문이 나와야 지연이 침묵에 숨는다.
# 8초로 두면 타임아웃이 걸리는 시점엔 이미 예산을 넘긴 뒤라 의미가 없다.
GEMINI_TIMEOUT=2.5
# 이 턴 전에는 AI 가 마무리를 골라도 따르지 않고 다시 여쭙는다.
# 턴 상한은 없다 (max_turn=0). 끝은 AI 의 close 판단과 「중단」 버튼이 정한다.
# 비우면 6 (question.DEFAULT_MIN_TURN). 낮추면 씨앗 한 줄에 정보가 다 찬 회차가 일찍 닫힌다.
MIN_TURN=

# 전사 — Azure Fast Transcription (배치)
# whisper-1 과 재보고 골랐다. 15초 음성 p90 이 921ms 대 2236ms 였고, 무엇보다
# 편차가 좁아 타이머 예산을 짜기 쉽다. README 「전사 (Azure)」 절 참조.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# 낭독 (같은 키를 쓴다. 호스트만 {region}.tts.speech.microsoft.com 이다)
# 실제로 어르신께 들려 드리고 고를 값이다. 기본값은 출발점일 뿐이다.
AZURE_TTS_VOICE=ko-KR-SunHiNeural
AZURE_TTS_RATE=-8%
# 합성 예산. T2 최솟값 3초에서 질문 생성이 쓰고 남은 자리다.
# 넘기면 소리 없이 글자만 나간다 — 회차는 계속된다.
AZURE_TTS_TIMEOUT=1.6

# 전사 예산. 실측 p90 이 15초 음성에 921ms, 34초에 1656ms 다.
# 6초는 「느린 것」이 아니라 「무언가 잘못된 것」을 가르는 선이다. 예산(T2 3초)보다
# 길게 잡은 것은 일부러다 — 전사가 실패하면 어르신이 방금 하신 말씀이 사라진다.
# 늦더라도 받아 오는 쪽을 고른다.
AZURE_STT_TIMEOUT=6.0
AZURE_STT_LOCALE=ko-KR

# 전사기에 넘기는 오디오를 wav 로 남길 폴더. **개발 중에만** — 비우면 꺼진다.
# 잘못 받아 적힌 턴을 들어 보고, 소리가 잘린 것인지 전사기가 틀린 것인지 가른다.
# PUBLIC_ORIGIN 이 있으면 적어 두어도 돌지 않는다.
STT_DUMP_DIR=

# ── 안전 천장 (요금 · 메모리) ─────────────────────────────────────────
# 전부 기본값이 있다. 비워 두면 코드의 기본값으로 돈다 —
# 상한을 **끄려면** 0 을 넣는다. 비우는 것과 0 은 다르다.

# max_turn 을 주지 않은 회차에 씌우는 턴 천장. 턴마다 Gemini·Azure 호출이 나간다.
# 여기 닿으면 closed_reason 이 turn_cap 으로 남는다 — 「AI 가 마무리를 못 골랐다」는
# 신호이고, 정상이라면 한 번도 보이지 않아야 한다.
TURN_CAP=60

# 진행 중인 회차를 메모리에서 버리는 기준(초). 마지막 **활동**부터 잰다.
# 폴링은 활동으로 세지 않는다 — 세면 열어 둔 채 잊은 탭이 영원히 산다.
SESSION_IDLE_SECONDS=1800
# 닫힌 회차를 지우기까지의 유예(초). 화면이 마지막 상태를 받아 갈 시간이다.
SESSION_CLOSED_SECONDS=300
# 스윕 주기(초).
SWEEP_EVERY_SECONDS=60
# 한 프로세스가 동시에 들고 있을 회차 수. 넘으면 새 회차에 503.
MAX_LIVE_SESSIONS=200

# 회차 생성 상한 — 인증이 없는 동안 지출의 유일한 입구다 (limits.py 참조).
CREATE_WINDOW_SECONDS=600
CREATE_MAX_PER_WINDOW=10
# 한 사용자가 동시에 들고 있을 회차 수. X-User-Id 를 그대로 믿는 값이라
# **보안이 아니다** — 탭을 여러 개 띄운 경우를 막는 정도다.
# 그리고 **로그인이 붙기 전까지는 아무 일도 하지 않는다.** 프론트가 모두에게
# dev-user 를 보내므로 이대로 적용하면 「전체 상한」이 되어 네 번째 어르신이
# 막힌다 — main.py 의 ANON_USER 가 그것을 걸러 낸다.
USER_LIVE_MAX=3

# (프록시 설정 TRUST_PROXY 는 맨 위 「배포」 절에 있다)

# ── 사진 ────────────────────────────────────────────────────────────
# 바이트를 어디에 둘지. pg = Postgres photo_blob 표 (기본), local = 파일.
# **모르는 값을 쓰면 기동이 멈춘다.** 조용히 기본값으로 떨어지면 사진이 딴 데
# 쌓이는데 아무도 모른다. 나중에 Blob 을 붙일 때 값이 하나 더 는다.
PHOTO_STORE=pg
# PHOTO_STORE=local 일 때만 쓴다. 상대 경로면 서버를 띄운 폴더 기준이다.
PHOTO_DIR=photos
# 받아들일 원본 상한(MB). 넘으면 본문을 다 받지 않고 413 으로 끊는다.
MAX_UPLOAD_MB=20
# 화면이 사진을 캐시해도 되는 시간(초). photo_id 가 가리키는 바이트는 바뀌지
# 않으니 길게 줘도 된다. private 과 함께 나가 중간 캐시에는 남지 않는다.
PHOTO_CACHE_SECONDS=86400
# 회차를 열 때 돌고 있는 사진 분석을 기다리는 한도(초). 넘기면 여는 말은
# 고정 문장이고 단서는 뒤늦게 붙는다.
PHOTO_OPEN_WAIT_SECONDS=3

# 신원 쿠키에 Secure 를 강제할지. 보통 비워 둔다 — https 요청이거나
# PUBLIC_ORIGIN 이 https 면 자동으로 붙는다. localhost(http)에서 켜면 브라우저가
# 쿠키를 저장하지 않아 사진이 안 보이고, 원인이 눈에 안 띈다.
COOKIE_SECURE=

# 엽서 (postcard.py). 카드 작성 에이전트(prompts/CardAgent_prompt_v3.md)가 제목·본문·
# 사진 설명을 쓰고, 회차 사진 위에 얹는다. 그림은 그리지 않는다.
# 글 모델을 비우면 GEMINI_MODEL 을 쓴다.
POSTCARD_TEXT_MODEL=
POSTCARD_TEXT_TIMEOUT=15
# 글을 얹을 한글 글꼴. 비우면 Windows 의 Noto Serif KR → 맑은 고딕 순으로 찾는다.
POSTCARD_FONT=
# 실패 · 지연 재현. **시험 서버에서만 건다.** 비우거나 off 면 주입하지 않는다.
#   generation_failed → 503 · insufficient_material → 409 (모델을 부르지 않는다)
POSTCARD_FAIL_INJECT=
# 모델을 부르기 전에 쉴 초 (최대 120). 그동안 같은 회차를 또 누르면 409 busy.
# 실패를 같이 걸지 않으면 쉰 뒤에 실제 모델을 부른다.
POSTCARD_INJECT_DELAY=

# 자서전 초안 (memoir.py · 실험). README 「자서전 초안」 절.
# 서버와 독립 실행이 같은 이름 · 같은 값을 읽는다. 엽서 설정과 따로다.
# 모델이 없어도 다른 모델로 바꾸지 않는다 — 502 다.
MEMOIR_TEXT_MODEL=gemini-3.5-flash-lite
MEMOIR_TEMPERATURE=0.3
MEMOIR_RESPONSE_MIME_TYPE=application/json
# 걸리면 JSON 이 잘려 502. 처음 값 2000 에서 올렸다 (자서전.md v1.3 부터 글이 길다).
MEMOIR_MAX_OUTPUT_TOKENS=3000
# 모델 호출을 기다리는 초. 넘기면 504. 처음 잡은 값이다.
MEMOIR_TEXT_TIMEOUT=20
# 한 번에 넣는 회차 상한 (최소 3). 단일 호출 구조의 임시 시험 제한이다 — 최종 정책이 아니다.
MEMOIR_MAX_SESSIONS=5
# 1 이면 화자 미지정 회차를 400 speaker_unassigned 로 거절한다. 화면이 화자를 정할 수 있게
# 되면 켠다. 꺼져 있어도 서로 다른 화자를 섞는 것은 늘 거절한다.
MEMOIR_REQUIRE_SPEAKER=0
# 실패 재현. **시험 서버에서만 건다.** 비우거나 off 면 주입하지 않는다.
#   source_material_unavailable → 422 · generation_failed → 502 · generation_timeout → 504
MEMOIR_FAIL_INJECT=

# ---------------------------------------------------------------- 로그인 (3-C1)
# Google Cloud OAuth 웹 클라이언트 ID. 비밀값이 아니다 (화면에도 실린다). 없으면 로그인 503.
GOOGLE_CLIENT_ID=
# 앱 세션 수명. **팀이 아직 정하지 않은 값이다** — 비우면 개발용 임시값(168 · 24).
# 절대 수명(시간, 정수) · 유휴 만료(시간, 소수 가능 — 0.5 = 30분, 0 이면 끈다)
SESSION_MAX_HOURS=
SESSION_IDLE_HOURS=
# 인터뷰 링크의 시작 전 유효 기간(시간). 끝난 뒤 대화를 읽을 수 있는 기간도 같다.
# **팀이 아직 정하지 않은 값이다** (D4) — 비우면 개발용 임시값 72.
LINK_HOURS=

# 자서전 5단계 파이프라인 (단위 8P). MEMOIR_ENGINE=pipeline 이면 서버 /api/memoirs/preview 도 이것을 쓴다.
# 비우거나 single 이면 예전 한 번 호출. tools/memoir_pipeline.py (독립 실험)도 같은 값을 읽는다.
MEMOIR_ENGINE=
# 자서전 작업(POST /api/memoirs)이 끝난 뒤 결과를 메모리에 두는 초. 기본 1800. 저장하지 않는다.
MEMOIR_JOB_KEEP_SECONDS=
# 위의 MEMOIR_* 와 따로다 — 한쪽을 바꿔도 다른 쪽은 그대로. 비우면 아래 기본값.
# 첫 실측용 값이다(최적값 아님). 재시도는 0 으로 고정, 장은 1~5.
MEMOIR_PIPE_TEXT_MODEL=
MEMOIR_PIPE_TEMPERATURE=
# gemini-3.1-pro-preview 는 생각에도 출력 토큰을 쓴다 — 6000 이면 목차 · 장이 잘린다 (10-28 실측). 단계마다 32768 권장.
# 단계별 초 / 출력 토큰 (v5). 기본 분석 90/8000 · 목차 60/6000 · 장(장마다) 90/6000 · 편집 150/10000 · 검증 90/6000
MEMOIR_PIPE_ANALYSIS_TIMEOUT=
MEMOIR_PIPE_ANALYSIS_MAX_OUTPUT_TOKENS=
MEMOIR_PIPE_OUTLINE_TIMEOUT=
MEMOIR_PIPE_OUTLINE_MAX_OUTPUT_TOKENS=
MEMOIR_PIPE_CHAPTER_TIMEOUT=
MEMOIR_PIPE_CHAPTER_MAX_OUTPUT_TOKENS=
MEMOIR_PIPE_EDIT_TIMEOUT=
MEMOIR_PIPE_EDIT_MAX_OUTPUT_TOKENS=
MEMOIR_PIPE_VERIFY_TIMEOUT=
MEMOIR_PIPE_VERIFY_MAX_OUTPUT_TOKENS=
# 전체 실행 상한 초. 기본 600
MEMOIR_PIPE_TOTAL_TIMEOUT=
